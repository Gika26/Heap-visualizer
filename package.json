{
    "name": "heap-visualizer",
    "displayName": "Heap Visualizer",
    "description": "A visualizer for binary heaps in VS Code",
    "version": "1.0.0",
    "publisher": "student",
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Other"
    ],
    "main": "./out/extension.js",
    "activationEvents": [
        "onCommand:heapVisualizer.open"
    ],
    "contributes": {
        "commands": [
            {
                "command": "heapVisualizer.open",
                "title": "Heap Visualizer: Open"
            }
        ]
    },
    "scripts": {
        "compile": "tsc -p .",
        "watch": "tsc -watch -p ."
    },
    "devDependencies": {
        "@types/vscode": "^1.85.0",
        "@types/node": "^20.12.12",
        "typescript": "^5.4.5"
    }
}